+/*
+ * Board check: the ADT root "compatible" lists xiaomi,alioth on the POCO F3
+ * (tools/boards/alioth.py). sweet-only drivers must not run there.
+ */
+static bool
+sweet_board_is(const char *want)
+{
+	DTEntry root;
+	void const *prop;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", &prop, &size) != kSuccess) {
+		return false;
+	}
+	const char *c = (const char *)prop;
+	unsigned int start = 0;
+	for (unsigned int i = 0; i <= size; i++) {
+		if (i == size || c[i] == 0) {
+			unsigned int k = 0;
+			while (start + k < i && want[k] && c[start + k] == want[k]) {
+				k++;
+			}
+			if (start + k == i && want[k] == 0) {
+				return true;
+			}
+			start = i + 1;
+		}
+	}
+	return false;
+}
