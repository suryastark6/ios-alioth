+static bool
+at_crc_ok(const uint8_t *rx, unsigned p, unsigned n, unsigned total)
+{
+	return p + n + 2u <= total &&
+	       at_crc16(rx + p, n) == (uint16_t)(rx[p + n] | (rx[p + n + 1] << 8));
+}
+
+/*
+ * Where the data starts: dp, or dp + at.shift once a shift has been seen.
+ * If neither checks out, try dp-3..dp+3 and keep a shift that does (bytes
+ * gained or lost in the FIFO path would move the frame). 0 = no match.
+ */
+static unsigned
+at_crc_find(const uint8_t *rx, unsigned dp, unsigned n, unsigned total)
+{
+	unsigned p = (unsigned)((int)dp + at.shift);
+	if (at_crc_ok(rx, p, n, total)) {
+		return p;
+	}
+	if (p != dp && at_crc_ok(rx, dp, n, total)) {
+		return dp;
+	}
+	for (int s = -3; s <= 3; ++s) {
+		p = (unsigned)((int)dp + s);
+		if (s && s != at.shift && at_crc_ok(rx, p, n, total)) {
+			if (n > 1) {
+				printf("ALIOTH TOUCH: CRC matches at data offset %+d (n=%u)\n", s, n);
+				at.shift = s;
+			}
+			return p;
+		}
+	}
+	return 0;
+}
