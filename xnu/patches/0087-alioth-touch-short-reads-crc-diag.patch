+static bool
+at_crc_ok(const uint8_t *rx, unsigned p, unsigned n, unsigned total)
+{
+	return p + n + 2u <= total &&
+	       at_crc16(rx + p, n) == (uint16_t)(rx[p + n] | (rx[p + n + 1] << 8));
+}
+
+/*
+ * Where the data starts: dp, or dp + at.shift once a shift has been seen.
+ * If neither checks out, try dp-3..dp+3 and keep a shift that does (bytes
+ * gained or lost in the FIFO path would move the frame). 0 = no match.
+ */
+static unsigned
+at_crc_find(const uint8_t *rx, unsigned dp, unsigned n, unsigned total)
+{
+	unsigned p = (unsigned)((int)dp + at.shift);
+	if (at_crc_ok(rx, p, n, total)) {
+		return p;
+	}
+	if (p != dp && at_crc_ok(rx, dp, n, total)) {
+		return dp;
+	}
+	for (int s = -3; s <= 3; ++s) {
+		p = (unsigned)((int)dp + s);
+		if (s && s != at.shift && at_crc_ok(rx, p, n, total)) {
+			if (n > 1) {
+				printf("ALIOTH TOUCH: CRC matches at data offset %+d (n=%u)\n", s, n);
+				at.shift = s;
+			}
+			return p;
+		}
+	}
+	return 0;
+}
+
+/* The first few bad frames, whole, with both CRCs (NOTES.md boot 14). */
+static void
+at_dump(uint8_t reg, const uint8_t *rx, unsigned dp, unsigned n, unsigned total)
+{
+	if (at.dumps >= 4) {
+		return;
+	}
+	++at.dumps;
+	printf("ALIOTH TOUCH: bad CRC reg=%#x n=%u calc=%04x got=%02x%02x irq=%#x\n",
+	    reg, n, at_crc16(rx + dp, n), rx[dp + n + 1], rx[dp + n], at.irq_status);
+	for (unsigned i = 0; i < total; i += 16) {
+		char line[16 * 3 + 1];
+		unsigned k = 0;
+		for (unsigned j = i; j < total && j < i + 16; ++j) {
+			static const char hex[] = "0123456789abcdef";
+			line[k++] = hex[rx[j] >> 4];
+			line[k++] = hex[rx[j] & 15];
+			line[k++] = ' ';
+		}
+		line[k] = 0;
+		printf("ALIOTH TOUCH: rx %02u: %s\n", i, line);
+	}
+}
