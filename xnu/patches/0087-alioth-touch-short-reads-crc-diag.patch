+/*
+ * One raw read, printed whole: header, data, CRC, and whether it checks.
+ * Boot 15: every 32-byte read of register 0x01 came back as 0x01 in every
+ * byte (header included) while the 1-byte chip id reads were right.
+ */
+static bool
+at_probe_one(unsigned div, uint8_t reg, unsigned n, bool dump)
+{
+	uint8_t tx[FTS_XFER_MAX] = {0}, rx[FTS_XFER_MAX] = {0};
+	unsigned dp = 4u + FTS_DUMMY, total = dp + n + 2u;
+	tx[0] = reg;
+	tx[1] = FTS_READ;
+	tx[2] = (uint8_t)(n >> 8);
+	tx[3] = (uint8_t)n;
+	int err = at_xfer(tx, rx, total);
+	bool ok = !err && !(rx[3] & 0xa0u) && at_crc_ok(rx, dp, n, total);
+	printf("ALIOTH TOUCH: probe div=%u reg=%#x n=%u err=%d st=%#x crc=%s irq=%#x rxc=%#x\n",
+	    div, reg, n, err, rx[3], ok ? "ok" : "BAD", at.irq_status, at_rd(at.se, SE_RX_COUNT));
+	for (unsigned i = 0; dump && i < total; i += 16) {
+		char line[16 * 3 + 1];
+		unsigned k = 0;
+		for (unsigned j = i; j < total && j < i + 16; ++j) {
+			static const char hex[] = "0123456789abcdef";
+			line[k++] = hex[rx[j] >> 4];
+			line[k++] = hex[rx[j] & 15];
+			line[k++] = ' ';
+		}
+		line[k] = 0;
+		printf("ALIOTH TOUCH:   %02u: %s\n", i, line);
+	}
+	delay(150);
+	return ok;
+}
