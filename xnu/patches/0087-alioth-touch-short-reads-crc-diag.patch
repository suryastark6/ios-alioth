+/*
+ * Reads of several registers and lengths at SPI clock dividers 4, 8 and 16
+ * (4.8, 2.4, 1.2 MHz). Keeps the fastest divider whose 32-byte report read
+ * passes, else divider 4. sweettouchprobe=0 skips it.
+ */
+static void
+at_probe(unsigned clk_div)
+{
+	static const struct { uint8_t reg; uint8_t n; } reads[] = {
+		{0xa3, 1}, {0xa3, 4}, {0xa3, 16}, {0x02, 1}, {0x01, 1}, {0x01, 8},
+		{0x00, 8}, {0x01, 32},
+	};
+	static const unsigned divs[] = {4, 8, 16};
+	unsigned keep = 0;
+	for (unsigned d = 0; d < sizeof(divs) / sizeof(divs[0]); ++d) {
+		at_wr(at.se, SE_MCLK, (clk_div * divs[d] / 4u << 4) | 1u);
+		delay(100);
+		bool report_ok = false;
+		for (unsigned r = 0; r < sizeof(reads) / sizeof(reads[0]); ++r) {
+			bool ok = at_probe_one(divs[d], reads[r].reg, reads[r].n, d == 0 || reads[r].n >= 8);
+			if (reads[r].reg == 0x01 && reads[r].n == 32) {
+				report_ok = ok;
+			}
+		}
+		if (report_ok && !keep) {
+			keep = divs[d];
+		}
+	}
+	if (!keep) {
+		keep = 4;
+		/* Last try: CS-to-clock and inter-word delays (SPI_DELAYS_COUNTERS
+		 * fields of spi-geni-qcom), at divider 4. Kept if it helps. */
+		at_wr(at.se, SE_MCLK, (clk_div << 4) | 1u);
+		at_wr(at.se, SPI_DELAYS, (16u << 10) | 8u);
+		delay(100);
+		(void)at_probe_one(104, 0x01, 8, true);
+		if (!at_probe_one(104, 0x01, 32, true)) {
+			at_wr(at.se, SPI_DELAYS, 0);
+		} else {
+			printf("ALIOTH TOUCH: probe keeps SPI delays\n");
+		}
+	}
+	at_wr(at.se, SE_MCLK, (clk_div * keep / 4u << 4) | 1u);
+	delay(100);
+	printf("ALIOTH TOUCH: probe done, SPI divider %u\n", clk_div * keep / 4u);
+}
